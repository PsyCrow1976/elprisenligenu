# DK1 = west of Storebælt, DK2 = east (Copenhagen / 2700 Brønshøj)
PRISKLASSE=DK2

# Existing PostgreSQL server (not created by this compose file)
POSTGRES_HOST=homepostgresql-db
POSTGRES_PORT=5432
POSTGRES_USER=home
POSTGRES_PASSWORD=
POSTGRES_DB=home

# FastHTML listen address inside the container
WEB_HOST=0.0.0.0
WEB_PORT=8088

# Optional. VAT is applied on top of the stored excl.-VAT totals (0.25 = 25%).
VAT_RATE=0.25

# Radius Elnet A/S is the grid company for 2700 Brønshøj. DT_C_01 = household Nettarif C.
NETSELSKAB_GLN=5790000705689
NETSELSKAB_NAME=Radius Elnet A/S
NETSELSKAB_CHARGE_CODE=DT_C_01
ENERGINET_GLN=5790000432752

# Optional Andel Energi kWh tillæg, kr/kWh excl. VAT.
# 0 = public charges only. 0.11664 ≈ FlexEnergi 14.58 øre/kWh inkl. moms.
SUPPLIER_NAME=Andel Energi
SUPPLIER_DKK_KWH=0

# In-process price job (today + tomorrow). Not system cron.
JOB_INTERVAL_HOURS=12
JOB_LOG_PATH=/var/log/elprisenligenu/prices.log
# JOB_INSTANCE=elprisenligenu
